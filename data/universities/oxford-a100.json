  "stage_2_interview_selection": {
    "verification_status": "mixed_official_and_historical_guidance",
    "source_ids": [
      "oxford_medsci_shortlisting_statistics_2025",
      "oxford_a100_technical_spec_v3"
    ],
    "primary_model": "academic_plus_ucat_weighting",
    "modifiers": [],
    "ranking_factors": [
      {
        "factor_id": "ucat_cognitive_total",
        "factor_type": "admissions_test",
        "weight_percent": 50,
        "points_available": 50,
        "source_field": "admissions_tests.ucat.total_score",
        "source_ids": [
          "oxford_medsci_shortlisting_statistics_2025"
        ],
        "notes": "Officially used in combination with GCSE performance; exact internal normalisation is not published."
      },
      {
        "factor_id": "contextualised_gcse_performance",
        "factor_type": "academic_record",
        "weight_percent": 50,
        "points_available": 50,
        "source_field": "gcse_profile",
        "source_ids": [
          "oxford_medsci_shortlisting_statistics_2025"
        ],
        "notes": "ApplySmart model combines count and proportion of 8/9/A* grades; Oxford's internal contextual algorithm is unpublished."
      }
    ],
    "calculation": {
      "verification_status": "mixed_official_and_historical_guidance",
      "source_ids": [
        "oxford_medsci_shortlisting_statistics_2025",
        "oxford_a100_technical_spec_v3"
      ],
      "score_components": [
        {
          "component_id": "ucat_component",
          "factor_id": "ucat_cognitive_total",
          "input_field": "admissions_tests.ucat.total_score",
          "calculation_method": "(UCAT / 2700) * 50",
          "scale": {
            "min": 0,
            "max": 50
          },
          "weight_percent": 50,
          "rounding": "round_to_2_decimal_places_after_total",
          "notes": "ApplySmart linear normalisation; not an official Oxford published formula.",
          "source_ids": [
            "oxford_a100_technical_spec_v3"
          ]
        },
        {
          "component_id": "gcse_component",
          "factor_id": "contextualised_gcse_performance",
          "input_field": "gcse_profile",
          "calculation_method": "((top_grade_count_score * 0.5) + (top_grade_proportion_score * 0.5)) scaled to 50",
          "scale": {
            "min": 0,
            "max": 50
          },
          "weight_percent": 50,
          "rounding": "round_to_2_decimal_places_after_total",
          "notes": "ApplySmart does not implement an executable Oxford-specific contextual GCSE uplift because Oxford's internal contextual algorithm is unpublished.",
          "source_ids": [
            "oxford_medsci_shortlisting_statistics_2025",
            "oxford_a100_technical_spec_v3"
          ]
        }
      ],
      "total_score": {
        "calculation_method": "ucat_component + gcse_component; GCSE component omitted and UCAT double-weighted for official GCSE exception routes.",
        "components": [
          "ucat_component",
          "gcse_component"
        ],
        "scale": {
          "min": 0,
          "max": 100
        },
        "notes": "Thresholds are ApplySmart modelled bands and must not be presented as Oxford cut-offs or official probabilities.",
        "source_ids": [
          "oxford_a100_technical_spec_v3"
        ]
      },
      "notes": "Public guidance must state that Oxford combines UCAT and contextualised GCSE achievement and does not publish a single UCAT cut-off."
    },
    "thresholds": [
      {
        "threshold_id": "home_very_likely_modelled",
        "applies_to_group_ids": [
          "home_fee"
        ],
        "metric": "selection_score",
        "operator": "greater_than_or_equal",
        "value": 84,
        "decision_outcome_if_not_met": "unknown",
        "source_ids": [
          "oxford_a100_technical_spec_v3"
        ],
        "notes": "ApplySmart modelled guidance boundary, not official Oxford cut-off."
      }
    ],
