{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://applysmart.local/schemas/subject-catalog.schema.json",
  "title": "ApplySmart Subject Catalog",
  "description": "Controlled dictionary of subject IDs, names, aliases, and categories.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "last_updated",
    "subjects",
    "categories",
    "usage"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "dataset_version": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "name",
          "aliases",
          "categories"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_id",
          "description"
        ],
        "properties": {
          "category_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "purpose",
        "rules"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
